# Cesium ion Configuration
# Get these values from https://ion.cesium.com/

# Your Cesium ion access token
# Create at: https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=your_token_here

# Asset IDs for Sapporo 3D Tiles
# After uploading each district's ZIP, get the ID from the asset URL
VITE_CESIUM_ASSET_ID_CHUO=123456   # 中央区 Chuo-ku
VITE_CESIUM_ASSET_ID_MINAMI=234567 # 南区 Minami-ku
VITE_CESIUM_ASSET_ID_NISHI=345678  # 西区 Nishi-ku
